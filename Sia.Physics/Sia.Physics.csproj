<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Physics</PackageId>
    <PackageDescription>Data-oriented physics layer for Sia ECS and Sia.Math</PackageDescription>
    <RepositoryUrl>https://github.com/lunditoph-siago/Sia.Physics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sia" Version="2.1.5" />
    <PackageReference Include="Sia.CodeGenerators" Version="2.1.5" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Sia.Math" Version="0.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Sia.Math" />
  </ItemGroup>

</Project>
