<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Sia.Math" />
    <Using Include="Sia.Engine.Rendering.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.Physics\Sia.Physics.csproj" />
    <PackageReference Include="Sia.WebGPU" Version="0.0.24" />
    <PackageReference Include="Sia.WebGPU.Native" Version="0.0.24" />
    <PackageReference Include="Sia.GLFW" Version="0.0.8"/>
    <PackageReference Include="Sia.GLFW.Native" Version="0.0.8" />
  </ItemGroup>
</Project>
